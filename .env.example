# Furtail Flutter App - optional environment variables
# Prefer using: flutter run --dart-define-from-file=env/new-api-emulator.json
# This file is provided for consistency with the delivery rule.

FURTAIL_API_BASE_URL=http://<lan-ip>:7300/api/v1
FURTAIL_SOCKET_URL=http://<lan-ip>:7300
FURTAIL_MEDIA_BASE_URL=http://<lan-ip>:9000
# Legacy aliases remain supported for rollback-safe compatibility.
API_BASE_URL=
API_HOST=
SOCKET_URL=
MEDIA_BASE_URL=

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

VIDEO_PROCESSING_ENABLED=true
VIDEO_MAX_UPLOAD_MB=100
VIDEO_KEEP_ORIGINAL=false
VIDEO_TARGET_HEIGHT=720
VIDEO_TARGET_CRF=28
VIDEO_QUEUE_CONCURRENCY=1
